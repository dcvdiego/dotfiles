#!/bin/sh
# bin-audit: report CLI tools installed OUTSIDE the tracked manifests
# (brew Brewfile / packages.yaml / mise config). Run periodically to spot drift.
# Self-updating agent CLIs in ~/.local/bin (claude, cursor-agent, agentmux, ...)
# are intentionally unmanaged - they appear here for review.

echo "== npm globals (tracked: Brewfile npm entries) =="
if command -v npm >/dev/null 2>&1; then
    npm ls -g --depth=0 2>/dev/null | tail -n +2
else
    echo "(npm not on PATH)"
fi

echo
echo "== uv tools (tracked: Brewfile uv entries) =="
command -v uv >/dev/null 2>&1 && uv tool list 2>/dev/null || echo "(uv not on PATH)"

echo
echo "== go installs =="
if command -v go >/dev/null 2>&1; then
    ls "$(go env GOPATH)/bin" 2>/dev/null || echo "(none)"
else
    echo "(go not on PATH)"
fi

echo
echo "== ~/.local/bin (self-managed agent CLIs + uv shims) =="
ls "$HOME/.local/bin" 2>/dev/null

echo
echo "== standalone install dirs (curl|bash leftovers) =="
for d in .atuin .bun .opencode .console-ninja Library/pnpm; do
    [ -e "$HOME/$d" ] && echo "present: ~/$d"
done

echo
echo "== mise tools (global config + conf.d) =="
command -v mise >/dev/null 2>&1 && mise ls --current 2>/dev/null || echo "(mise not on PATH)"
