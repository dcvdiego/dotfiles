# ── dev-notes: background session note-taker ──────────────────────────────────
# Wraps opencode and codex so that after each session ends, generate-note.sh
# runs in the background to write a note to the Obsidian vault.

_dev_notes_fire() {
  [[ -x ~/.config/dev-notes/generate-note.sh ]] || return 0
  local tool="$1"
  local _branch _repo _remote
  _branch=$(git branch --show-current 2>/dev/null || true)
  _repo=$(basename "$(git rev-parse --show-toplevel 2>/dev/null)" 2>/dev/null || true)
  _remote=$(git remote get-url origin 2>/dev/null || true)
  (GIT_BRANCH="$_branch" GIT_REPO="$_repo" GIT_REMOTE="$_remote" TOOL="$tool" \
  # nohup: the note must survive the pane closing (SIGHUP on PTY close).
    nohup ~/.config/dev-notes/generate-note.sh </dev/null >>~/.config/dev-notes/dev-notes.log 2>&1 &)
}

function opencode() {
  command opencode "$@"
  local _exit=$?
  _dev_notes_fire "opencode"
  return $_exit
}

function codex() {
  command codex "$@"
  local _exit=$?
  _dev_notes_fire "codex"
  return $_exit
}

function copilot() {
  local _start_epoch
  _start_epoch=$(date +%s)
  command copilot "$@"
  local _exit=$?
  # Pass the start epoch so the script finds the right session-state folder.
  # nohup: the note must survive the pane/agent closing (SIGHUP on PTY close).
  GIT_BRANCH="$(git branch --show-current 2>/dev/null || true)" \
  GIT_REPO="$(basename "$(git rev-parse --show-toplevel 2>/dev/null)" 2>/dev/null || true)" \
  GIT_REMOTE="$(git remote get-url origin 2>/dev/null || true)" \
  TOOL=copilot \
  SESSION_START_EPOCH="$_start_epoch" \
  nohup ~/.config/dev-notes/generate-note.sh </dev/null >>~/.config/dev-notes/dev-notes.log 2>&1 &!
  return $_exit
}

# Keep skhd coupled to Komorebi rather than running it at login, where it
# conflicts with AeroSpace's global shortcuts.
function komorebic() {
  case "$1" in
    start)
      command komorebic "$@"
      local status=$?
      if (( status == 0 )); then
        pkill -x skhd 2>/dev/null
        "${HOMEBREW_PREFIX:-/opt/homebrew}/bin/skhd" -c "$HOME/.config/komorebi/skhdrc" \
          >/tmp/skhd.out.log 2>/tmp/skhd.err.log &!
      fi
      return $status
      ;;
    stop)
      pkill -x skhd 2>/dev/null
      command komorebic "$@"
      ;;
    *)
      command komorebic "$@"
      ;;
  esac
}

function krestart() {
  komorebic stop
  sleep 2
  pkill -x komorebi 2>/dev/null
  sleep 2
  komorebic start
}

