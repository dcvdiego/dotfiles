[Unit]
Description=herdr-codexbar: push CodexBar quota into herdr's agent sidebar
After=herdr-server.service

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/codexbar/env
ExecStart=%h/.local/bin/herdr-codexbar refresh
