[Unit]
Description=CodexBar quota watcher (fires ~/.local/bin/quota-notify hooks)
After=network-online.target

[Service]
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/codexbar/env
ExecStart=%h/.local/bin/codexbar hooks watch --interval 300
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
