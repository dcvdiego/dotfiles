{{ if eq .chezmoi.os "darwin" -}}
#!/bin/sh
set -eu

if ! command -v brew >/dev/null 2>&1; then
    echo "brew not found; install Homebrew then re-run: chezmoi init --apply"
    exit 0
fi

# Full macOS state (taps, formulae, casks, vscode extensions).
# Brewfile content is embedded so this script re-runs whenever it changes.
brew bundle --file=/dev/stdin <<'BREWEOF'
{{ include "Brewfile" -}}
BREWEOF
{{ else if eq .chezmoi.os "linux" -}}
{{ $agents := eq (includeTemplate "role" .) "agents" -}}
#!/bin/sh
set -eu

{{ if $agents -}}
# role=agents: apt prerequisites are provisioned by root (see homelab docs/agents.md)
{{ else -}}
# apt prerequisites (sudo required)
if command -v apt-get >/dev/null 2>&1; then
    sudo apt-get update -y
    sudo apt-get install -y zsh git curl file build-essential procps
fi
{{- end }}

# Homebrew-on-Linux: identical names/versions as macOS
if ! command -v brew >/dev/null 2>&1; then
    [ -x /home/linuxbrew/.linuxbrew/bin/brew ] || \
        NONINTERACTIVE=1 /bin/bash -c \
        "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
[ -x /home/linuxbrew/.linuxbrew/bin/brew ] && \
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"

if ! command -v brew >/dev/null 2>&1; then
    echo "brew unavailable; skipping package install"
    exit 0
fi

# Cross-platform set from .chezmoidata/packages.yaml (embedded => re-runs on change)
brew bundle --file=/dev/stdin <<'BREWEOF'
{{ if $agents -}}
{{ range .agent_packages -}}
brew "{{ . }}"
{{ end -}}
{{ else -}}
tap "anomalyco/tap"
tap "datadog-labs/pack"
tap "golangci/tap"
{{ range .packages -}}
brew "{{ . }}"
{{ end -}}
brew "golangci/tap/golangci-lint"
brew "anomalyco/tap/opencode", trusted: true
brew "datadog-labs/pack/pup", trusted: true
{{ end -}}
BREWEOF

echo "Done. To make zsh the default shell: chsh -s \$(which zsh)"
{{ end -}}
