{{ if eq .chezmoi.os "linux" -}}
#!/bin/sh
set -eu

# --- apt basics (sudo required) ---
if command -v apt-get >/dev/null 2>&1; then
    echo "Installing apt prerequisites..."
    sudo apt-get update -y
    sudo apt-get install -y zsh git curl file build-essential procps
fi

# --- Homebrew on Linux ---
if ! command -v brew >/dev/null 2>&1; then
    echo "Installing Homebrew-on-Linux..."
    NONINTERACTIVE=1 /bin/bash -c \
        "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

if [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

echo "Installing common brew bundle (~/.config/brew/Brewfile.common)..."
brew bundle --file="$HOME/.config/brew/Brewfile.common"

echo "Done. To make zsh the default shell: chsh -s \$(which zsh)"
{{ end -}}
